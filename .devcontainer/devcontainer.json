{
  "name": "SuperKart deployment",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [7860, 8501],
  "portsAttributes": {
    "7860": {"label": "SuperKart API (Flask)"},
    "8501": {"label": "SuperKart app (Streamlit)"}
  },
  "postStartCommand": "bash .devcontainer/start.sh"
}
